# کپی این فایل به .env کن (یا همین مقادیر را در .env خودت قرار بده)
# برای داکر این مقادیر دیتابیس را استفاده کن

APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cosco
DB_USERNAME=cosco
DB_PASSWORD=secret
